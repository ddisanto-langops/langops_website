{
  "compilerOptions": {
    "target": "es2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "../",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@shared/types": ["../shared/types.ts"]
    },
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}