{
  "compilerOptions": {
    "target": "es2025",
    "jsx": "react-jsx",

    /* Modules & Resolution */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    
    /* Vite & Build Specifics */
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src", 
    "types"
  ]
}
