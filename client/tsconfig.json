{
  "compilerOptions": {
    "target": "es2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@shared/types": ["../shared/types.ts"],
      "@shared/enums": ["../shared/enums.ts"]
    },
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}